{
  "name": "app",
  "private": "true",
  "dependencies": {
    "@hotwired/turbo-rails": "^8.0.23",
    "@protomaps/basemaps": "^5.7.2",
    "@tailwindcss/cli": "^4.3.4",
    "@tailwindcss/forms": "^0.5.11",
    "esbuild": "^0.28.2",
    "maplibre-gl": "^6.16.0",
    "micromodal": "^0.7.0",
    "ralix": "^1.9.2",
    "tailwindcss": "^4.3.4",
    "tippy.js": "^6.3.7"
  },
  "scripts": {
    "build": "cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs app/assets/builds/maplibre-gl-worker.js && esbuild app/javascript/*.* --bundle --sourcemap --outdir=app/assets/builds --public-path=assets",
    "build:css": "tailwindcss -i ./app/assets/stylesheets/application.css -o ./app/assets/builds/application.css --minify"
  },
  "packageManager": "yarn@1.22.22"
}
